{
  "name": "chromeless",
  "productName": "Chromeless",
  "description": "Turn Any Websites into Site-specific Browsers",
  "version": "4.6.0",
  "scriptVersion": "2.14.0",
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "bun@1.3.13",
  "main": "build/electron.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && bun run generate-open-source-notices",
    "generate-open-source-notices": "license-checker-rseidelsohn --markdown > public/open-source-notices.txt",
    "build": "vite build && tsdown --config-loader unrun",
    "bundle": "tsdown --config-loader unrun",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint-fix": "biome check --write .",
    "start": "vite",
    "electron-dev": "concurrently \"cross-env BROWSER=none bun run start\" \"bun scripts/wait-for-url.ts http://localhost:3000 && cross-env API_URL=http://localhost:3000/api electron .\" -k",
    "dist": "bun run build && cross-env NODE_ENV=production bun dist.ts",
    "dist-dev": "bun run build && cross-env NODE_ENV=production CSC_IDENTITY_AUTO_DISCOVERY=false bun dist.ts"
  },
  "repository": "https://github.com/kitsuyui/chromeless",
  "author": {
    "name": "WebCatalog Ltd",
    "email": "contact@webcatalog.ltd"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@electron/notarize": "3.1.1",
    "@electron/remote": "2.1.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.2.10",
    "@mui/icons-material": "5.18.0",
    "@mui/lab": "5.0.0-alpha.177",
    "@mui/material": "5.18.0",
    "@mui/styles": "5.18.0",
    "@types/node": "^24.10.1",
    "@types/react": "18",
    "@types/react-dom": "18",
    "cheerio": "1.2.0",
    "comlink": "4.4.2",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "decompress": "4.2.1",
    "electron": "41.5.0",
    "electron-builder": "26.8.1",
    "electron-context-menu": "4.1.2",
    "electron-settings": "4.0.4",
    "electron-updater": "6.8.3",
    "electron-window-state": "5.0.3",
    "env-paths": "4.0.0",
    "fs-extra": "11.3.4",
    "icon-gen": "5.0.0",
    "jimp": "1.6.1",
    "license-checker-rseidelsohn": "4.4.2",
    "menubar": "9.5.2",
    "notistack": "3.0.2",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "react-window": "2.2.7",
    "react-window-infinite-loader": "2.0.1",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0",
    "reselect": "5.1.1",
    "semver": "7.7.4",
    "slugify": "1.6.9",
    "sudo-prompt": "9.2.1",
    "tsdown": "0.21.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "overrides": {
    "@electron/asar": "4.2.0",
    "@electron/universal": "3.0.4",
    "ajv": "6.14.0",
    "ejs": "3.1.10",
    "http-cache-semantics": "4.1.1",
    "lodash": "4.18.1",
    "semver": "7.7.4",
    "tmp": "0.2.5"
  },
  "private": true
}
