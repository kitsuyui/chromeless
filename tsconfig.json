{
  "compilerOptions": {
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022"
  },
  "include": ["src", "main-src", "scripts", "dist.js", "vite.config.js", "tsdown.config.js"]
}
