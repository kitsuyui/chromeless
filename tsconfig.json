{
  "compilerOptions": {
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022"
  },
  "include": [
    "src",
    "main-src",
    "scripts",
    "dist.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tsdown.config.ts"
  ]
}
